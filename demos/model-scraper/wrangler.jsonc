{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "model-scraper",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-24",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "production"
	},
	"env": {
		"development": {
			"name": "model-scraper-dev",
			"vars": {
				"ENVIRONMENT": "development"
			},
			"ai": {
				"binding": "AI"
			},
			"kv_namespaces": [
				{
					"binding": "JSON_DATA",
					"id": "e37eeec327c54a73a68e1336d1df411d",
					"preview_id": "e37eeec327c54a73a68e1336d1df411d"
				}
			]
		},
		"staging": {
			"name": "model-scraper-staging",
			"vars": {
				"ENVIRONMENT": "staging"
			},
			"ai": {
				"binding": "AI"
			},
			"kv_namespaces": [
				{
					"binding": "JSON_DATA",
					"id": "e37eeec327c54a73a68e1336d1df411d"
				}
			]
		}
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "JSON_DATA",
			"id": "e37eeec327c54a73a68e1336d1df411d"
		}
	]
}
